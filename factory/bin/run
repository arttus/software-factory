#!/usr/bin/env python3
"""Controller entry point (foundation build).

Usage:
  run --plan            resolve profiles and routing without launching work
  run --probe           probe registered adapters and print their capabilities
  run --smoke           run one fake-builder invocation through the controller
  run <issue>           explain what still has to land before jobs run here

The controller writes invocation evidence under
factory/jobs/<job-id>/runs/<invocation-id>/ and never advances a job stage.
"""

from __future__ import annotations

import argparse
import json
import sys
import tempfile
from pathlib import Path

REPO = Path(__file__).resolve().parents[2]
sys.path.insert(0, str(REPO))

from factory.adapters import build_registry  # noqa: E402
from factory.adapters.fake import FakeAdapter  # noqa: E402
from factory.core.config import ConfigError, load_config  # noqa: E402
from factory.core.controller import Controller, ControllerError  # noqa: E402
from factory.core.contracts import InvocationRequest, new_invocation_id, utc_now  # noqa: E402
from factory.core.roles import RoleError, load_roles  # noqa: E402

CONFIG_PATH = REPO / "factory" / "config.json"


def plan(config_path: str, role_set: str | None) -> int:
    config = load_config(config_path, role_set=role_set)
    roles = load_roles(REPO)
    print(f"role set {config.role_set}: schema {config.schema_version}, "
          f"{len(config.profiles)} profiles, {len(config.adapters)} adapters, "
          f"{len(roles)} roles")
    for role in ("intake", "spec", "builder", "approver"):
        profile = config.role_profile(role)
        print(f"  {role:<8} → {profile.name} ({profile.adapter}:{profile.model}, "
              f"{profile.permission_profile})")
    for risk in ("low", "medium", "high"):
        resolved = config.reviewers_for(risk)
        print(f"  risk {risk}: " + ", ".join(f"{role}={p.name}" for role, p in resolved.items()))
    for surface in ("ui", "security"):
        resolved = config.reviewers_for("low", [surface])
        extra = {r: p for r, p in resolved.items() if r != "code"}
        print(f"  surface {surface}: " + ", ".join(f"{role}={p.name}" for role, p in extra.items()))
    return 0


def probe(config_path: str, role_set: str | None) -> int:
    config = load_config(config_path, role_set=role_set)
    load_roles(REPO)
    registry = build_registry(REPO)
    for name in sorted(registry):
        report = registry[name].probe()
        print(f"{name}: {report.version or 'unknown version'}")
        for capability in sorted(report.capabilities):
            print(f"  {capability}: {report.capabilities[capability]}")
        print()
    for name in sorted(config.enabled_adapters()):
        if name not in registry:
            print(f"{name}: enabled in config but no controller adapter is available")
    return 0


def smoke(config_path: str, role_set: str | None) -> int:
    config = load_config(config_path, role_set=role_set)
    roles = load_roles(REPO)
    with tempfile.TemporaryDirectory(prefix="factory-smoke-") as tmp:
        root = Path(tmp)
        job_dir = root / "jobs" / "smoke"
        job_dir.mkdir(parents=True)
        role = roles["builder"]
        request = InvocationRequest(
            invocation_id=new_invocation_id(),
            job_id="smoke",
            stage="build",
            round=1,
            attempt=1,
            role="builder",
            controller_root=str(REPO),
            job_dir=str(job_dir),
            instruction_path=f"factory/roles/{role.name}.md",
            instruction_digest=role.digest,
            outputs=["build.md"],
            profile="fake-builder",
            adapter="fake",
            model="fake-model",
            required_capabilities=list(role.capabilities),
            permission_profile="builder",
            created_at=utc_now(),
        )
        controller = Controller.from_config(config, root, adapters={"fake": FakeAdapter(root)})
        result = controller.run(request)
        output = job_dir / "build.md"
        print(f"smoke: {result.status} exit {result.exit_code} "
              f"artifact {output} ({output.stat().st_size} bytes)")
        runs = list((root / "jobs" / "smoke" / "runs").glob("*/result.json"))
        print(f"evidence: {len(runs)} result.json")
        print(f"first line: {output.read_text().splitlines()[0]}")
    return 0


def main(argv: list[str]) -> int:
    parser = argparse.ArgumentParser(description="Factory controller entry point.")
    parser.add_argument("--config", default=str(CONFIG_PATH))
    parser.add_argument("--role-set", default=None)
    group = parser.add_mutually_exclusive_group()
    group.add_argument("--plan", action="store_true")
    group.add_argument("--probe", action="store_true")
    group.add_argument("--smoke", action="store_true")
    parser.add_argument("issue", nargs="?")
    args = parser.parse_args(argv)

    if args.plan:
        return plan(args.config, args.role_set)
    if args.probe:
        return probe(args.config, args.role_set)
    if args.smoke:
        return smoke(args.config, args.role_set)
    if args.issue and args.issue.isdigit():
        print("run: controller execution for real issues is not enabled in this build. "
              "Use /factory run in Claude Code, or run --smoke to exercise the adapter contract.")
        return 2
    parser.print_help()
    return 2


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except (ConfigError, RoleError, ControllerError) as exc:
        print(f"run: {exc}", file=sys.stderr)
        sys.exit(1)
