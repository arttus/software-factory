{
  "schema_version": 2,
  "concurrency": 3,
  "max_rounds": 3,
  "base_branch": "main",
  "merge_method": "merge",
  "merge_policy": "human",
  "labels": {
    "queue": "factory",
    "needs_info": "factory:needs-info",
    "needs_human": "factory:needs-human"
  },
  "adapters": {
    "claude": {
      "executable": "claude",
      "enabled": true,
      "version_command": ["--version"],
      "verified_versions": ["2.1.257+"]
    },
    "kilo": {
      "executable": "kilo",
      "enabled": true,
      "version_command": ["--version"],
      "verified_versions": ["7.8.12"]
    },
    "codex": {
      "executable": "codex",
      "enabled": false,
      "version_command": ["--version"],
      "verified_versions": []
    },
    "command-code": {
      "executable": "cmd",
      "enabled": true,
      "version_command": ["--version"],
      "verified_versions": ["1.53.1"]
    },
    "fake": {
      "executable": null,
      "enabled": true,
      "version_command": [],
      "verified_versions": []
    }
  },
  "permission_profiles": {
    "intake": {
      "shell": false,
      "network": false,
      "write_scope": "output_only"
    },
    "spec": {
      "shell": true,
      "network": false,
      "write_scope": "output_only"
    },
    "builder": {
      "shell": true,
      "network": true,
      "write_scope": "worktree_and_output"
    },
    "reviewer": {
      "shell": false,
      "network": false,
      "write_scope": "output_only"
    },
    "approver": {
      "shell": true,
      "network": false,
      "write_scope": "output_only"
    }
  },
  "profiles": {
    "claude-intake": {
      "adapter": "claude",
      "model": "fable",
      "permission_profile": "intake"
    },
    "claude-spec": {
      "adapter": "claude",
      "model": "opus",
      "permission_profile": "spec"
    },
    "claude-builder": {
      "adapter": "claude",
      "model": "opus",
      "permission_profile": "builder"
    },
    "claude-approver": {
      "adapter": "claude",
      "model": "opus",
      "permission_profile": "approver"
    },
    "claude-code-haiku": {
      "adapter": "claude",
      "model": "haiku",
      "permission_profile": "reviewer"
    },
    "claude-code-sonnet": {
      "adapter": "claude",
      "model": "sonnet",
      "permission_profile": "reviewer"
    },
    "claude-ux-sonnet": {
      "adapter": "claude",
      "model": "sonnet",
      "permission_profile": "reviewer"
    },
    "claude-ui-haiku": {
      "adapter": "claude",
      "model": "haiku",
      "permission_profile": "reviewer"
    },
    "claude-security-opus": {
      "adapter": "claude",
      "model": "opus",
      "permission_profile": "reviewer"
    },
    "fake-builder": {
      "adapter": "fake",
      "model": "fake-model",
      "permission_profile": "builder"
    },
    "kilo-intake": {
      "adapter": "kilo",
      "provider": "openrouter",
      "model": "openrouter/anthropic/claude-sonnet-4.5",
      "permission_profile": "intake"
    },
    "kilo-spec": {
      "adapter": "kilo",
      "provider": "openrouter",
      "model": "openrouter/anthropic/claude-sonnet-4.5",
      "permission_profile": "spec"
    },
    "kilo-builder": {
      "adapter": "kilo",
      "provider": "openrouter",
      "model": "openrouter/anthropic/claude-sonnet-4.5",
      "permission_profile": "builder"
    },
    "kilo-approver": {
      "adapter": "kilo",
      "provider": "openrouter",
      "model": "openrouter/anthropic/claude-sonnet-4.5",
      "permission_profile": "approver"
    },
    "kilo-code-haiku": {
      "adapter": "kilo",
      "provider": "openrouter",
      "model": "openrouter/anthropic/claude-haiku-4.5",
      "permission_profile": "reviewer"
    },
    "kilo-code-sonnet": {
      "adapter": "kilo",
      "provider": "openrouter",
      "model": "openrouter/anthropic/claude-sonnet-4.5",
      "permission_profile": "reviewer"
    },
    "kilo-ux-sonnet": {
      "adapter": "kilo",
      "provider": "openrouter",
      "model": "openrouter/anthropic/claude-sonnet-4.5",
      "permission_profile": "reviewer"
    },
    "kilo-ui-haiku": {
      "adapter": "kilo",
      "provider": "openrouter",
      "model": "openrouter/anthropic/claude-haiku-4.5",
      "permission_profile": "reviewer"
    },
    "kilo-security-opus": {
      "adapter": "kilo",
      "provider": "openrouter",
      "model": "openrouter/anthropic/claude-opus-5.5",
      "permission_profile": "reviewer"
    },
    "cc-intake": {
      "adapter": "command-code",
      "provider": "commandcode",
      "model": "moonshotai/kimi-k2.7-code",
      "permission_profile": "intake"
    },
    "cc-spec": {
      "adapter": "command-code",
      "provider": "commandcode",
      "model": "moonshotai/kimi-k2.7-code",
      "permission_profile": "spec"
    },
    "cc-builder": {
      "adapter": "command-code",
      "provider": "commandcode",
      "model": "moonshotai/kimi-k2.7-code",
      "permission_profile": "builder"
    },
    "cc-approver": {
      "adapter": "command-code",
      "provider": "commandcode",
      "model": "moonshotai/kimi-k2.7-code",
      "permission_profile": "approver"
    },
    "cc-code-haiku": {
      "adapter": "command-code",
      "provider": "commandcode",
      "model": "deepseek/deepseek-v4-flash",
      "permission_profile": "reviewer"
    },
    "cc-code-sonnet": {
      "adapter": "command-code",
      "provider": "commandcode",
      "model": "moonshotai/kimi-k2.7-code",
      "permission_profile": "reviewer"
    },
    "cc-ux-sonnet": {
      "adapter": "command-code",
      "provider": "commandcode",
      "model": "moonshotai/kimi-k2.7-code",
      "permission_profile": "reviewer"
    },
    "cc-ui-haiku": {
      "adapter": "command-code",
      "provider": "commandcode",
      "model": "deepseek/deepseek-v4-flash",
      "permission_profile": "reviewer"
    },
    "cc-security-opus": {
      "adapter": "command-code",
      "provider": "commandcode",
      "model": "moonshotai/kimi-k2.7-code",
      "permission_profile": "reviewer"
    }
  },
  "roles": {
    "intake": "claude-intake",
    "spec": "claude-spec",
    "builder": "claude-builder",
    "approver": "claude-approver"
  },
  "routing": {
    "low":    { "code": "claude-code-haiku" },
    "medium": { "code": "claude-code-sonnet" },
    "high":   { "code": "claude-code-sonnet" }
  },
  "surface_reviewers": {
    "ui": { "ux": "claude-ux-sonnet", "ui": "claude-ui-haiku" },
    "security": { "security": "claude-security-opus" }
  },
  "default_role_set": "claude",
  "role_sets": {
    "command-code": {
      "roles": {
        "intake": "cc-intake",
        "spec": "cc-spec",
        "builder": "cc-builder",
        "approver": "cc-approver"
      },
      "routing": {
        "low":    { "code": "cc-code-haiku" },
        "medium": { "code": "cc-code-sonnet" },
        "high":   { "code": "cc-code-sonnet" }
      },
      "surface_reviewers": {
        "ui": { "ux": "cc-ux-sonnet", "ui": "cc-ui-haiku" },
        "security": { "security": "cc-security-opus" }
      }
    }
  },
  "limits": {
    "jobs": 3,
    "workers": 4,
    "per_adapter": {
      "claude": 3,
      "fake": 4
    }
  },
  "browser": {
    "command": "agent-browser",
    "start_command": null,
    "url": null,
    "ready_timeout_seconds": 60,
    "viewports": [
      { "name": "desktop", "width": 1440, "height": 900 },
      { "name": "mobile", "width": 390, "height": 844 }
    ]
  },
  "protected_paths": [
    "factory/checks.sh",
    "factory/config.json"
  ],
  "ports": { "base": 5100, "step": 10 },
  "prices_usd_per_mtok": {
    "claude-fable-5-1":  { "input": 10.0, "output": 50.0, "cache_write_5m": 12.5, "cache_write_1h": 20.0, "cache_read": 0.25 },
    "claude-opus-5-5":   { "input": 4.0,  "output": 20.0, "cache_write_5m": 5.0,  "cache_write_1h": 8.0,  "cache_read": 0.20 },
    "claude-sonnet-5-5": { "input": 2.0,  "output": 10.0, "cache_write_5m": 2.5,  "cache_write_1h": 4.0,  "cache_read": 0.20 },
    "claude-haiku-5-5":  { "input": 0.10, "output": 0.50, "cache_write_5m": 0.125, "cache_write_1h": 0.20, "cache_read": 0.01 }
  }
}
